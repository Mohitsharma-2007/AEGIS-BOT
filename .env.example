# ============================================================
# AEGIS BOT — Environment Configuration Template
# NOTE: DO NOT PUT ACTUAL API KEYS OR SECRETS IN THIS FILE.
# ============================================================

# Server Ports
PORT=3001
VITE_PORT=3000
BACKEND_WS_URL=ws://localhost:3001

# Default Provider & Model
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=qwen/qwen3.8-27b:free

# OpenRouter (Free Tier & Router)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq LPU
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Nvidia NIM
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Conduit
CONDUIT_API_KEY=your_conduit_api_key_here
CONDUIT_BASE_URL=https://conduit.ozdoev.net/v1

# TokenHarbor
TOKENHARBOR_API_KEY=your_tokenharbor_api_key_here
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1

# Vercel AI Gateway (JEV Model Evaluator)
VERCEL_AI_KEY=your_vercel_ai_gateway_key_here
VERCEL_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

# Bai & OpenCode Custom Endpoints
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Browser Runtime Configuration
# Options: 'system' (uses installed Chrome.exe for local dev) or 'managed' (production/cloud runtime)
BROWSER_RUNTIME=system
CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
MANAGED_CHROMIUM_PATH=
HEADLESS=true
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
